# Copy to terraform.tfvars and adjust. Never commit terraform.tfvars (gitignored).

project_name = "portfolio-lab"
environment  = "lab"
aws_region   = "us-east-1"

# Match AZs to your region:
availability_zones = ["us-east-1a", "us-east-1b"]

# Phase 1 VPC + Phase 2 compute (ALB/ASG)
# NAT off = cheaper; ASG uses public subnets so instances can reach dnf.
# NAT on  = ASG in private subnets (production-like; ~$32+/mo for NAT).
enable_nat_gateway = false
enable_compute     = true

# ASG sizing (t3.micro is free-tier eligible in many accounts)
instance_type        = "t3.micro"
asg_min_size         = 1
asg_max_size         = 2
asg_desired_capacity = 2

enable_rds        = false
enable_s3_static  = false
enable_monitoring = false
