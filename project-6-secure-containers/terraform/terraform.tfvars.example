project_name         = "project6"
environment          = "lab"
aws_region           = "us-east-1"
ecr_repository_name  = "project6-api"
ecr_force_delete     = true
ecr_scan_on_push     = true
ecr_keep_image_count = 5

# Phase 2
vpc_cidr           = "10.60.0.0/16"
container_port     = 8080
image_tag          = "latest"
fargate_cpu        = "256"
fargate_memory     = "512"
desired_count      = 1
log_retention_days = 7

# Phase 3 — value is stored in Secrets Manager (override locally in terraform.tfvars if you want)
# app_secret_demo = "phase3-secrets-manager-demo"

# Phase 4
alert_email        = "you@example.com"
monthly_budget_usd = "20"

# Phase 5
github_actions_role_name = "project6-github-actions-ecr-ecs"
github_repository        = "mrbobbyboykin/Projects"
github_branch            = "main"
enable_waf               = true
enable_guardduty         = true
